-- ANTI AIM LOGIC
local antiAimSettings = {
   enabled = false, yawtype = "none", pitchtype = "none",
   angletype = "none", customangle = 0,
   minspeed = 10, maxspeed = 20, minangle = 30, maxangle = 60,
   randomangle = false,
}

local function updantiaim(deltatime)
   if not antiAimSettings.enabled then return end
   if antiAimSettings.yawtype == "none" and antiAimSettings.pitchtype == "none" and antiAimSettings.angletype == "none" then
      return
   end
   local curweap = curweap2()
   if not curweap then return end
   local character = LocalPlayer.Character
   if not character then return end
   local rootpart = character:FindFirstChild("HumanoidRootPart")
   if not rootpart then return end
   
   local yaw = 0
   local currenttime = tick()
   if antiAimSettings.yawtype == "jitter" then
      local minangle = math.rad(antiAimSettings.minangle)
      local maxangle = math.rad(antiAimSettings.maxangle)
      if antiAimSettings.randomangle then
         yaw = minangle + math.random() * (maxangle - minangle)
      else
         yaw = math.random() > 0.5 and minangle or -minangle
      end
   elseif antiAimSettings.yawtype == "spinbot" then
      local speed = (antiAimSettings.minspeed / 10) + math.random() * ((antiAimSettings.maxspeed - antiAimSettings.minspeed) / 10)
      yaw = (currenttime * speed) % (2 * math.pi)
   elseif antiAimSettings.yawtype == "random" then
      yaw = -math.rad(antiAimSettings.maxangle) + math.random() * (2 * math.rad(antiAimSettings.maxangle))
   end
   
   local pitch = 0
   if antiAimSettings.pitchtype == "jitter" then
      local minangle = math.rad(antiAimSettings.minangle)
      local maxangle = math.rad(antiAimSettings.maxangle)
      if antiAimSettings.randomangle then
         pitch = -maxangle + math.random() * (maxangle - (-maxangle))
      else
         pitch = math.random() > 0.5 and minangle or -minangle
      end
   elseif antiAimSettings.pitchtype == "spinbot" then
      pitch = math.sin(tick() * (antiAimSettings.maxspeed / 10)) * math.rad(antiAimSettings.maxangle)
   end
   
   local roll = 0
   if antiAimSettings.angletype == "tilt 45" then
      roll = math.rad(45)
   elseif antiAimSettings.angletype == "tilt 90" then
      roll = math.rad(90)
   elseif antiAimSettings.angletype == "upside down" then
      roll = math.rad(180)
   elseif antiAimSettings.angletype == "custom" then
      roll = math.rad(antiAimSettings.customangle)
   end
   
   local rotationcframe = CFrame.Angles(pitch, yaw, roll)
   rootpart.CFrame = rootpart.CFrame * rotationcframe
end

RunService.Heartbeat:Connect(function(dt)
   updantiaim(dt)
end)

